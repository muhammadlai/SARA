# ──────────────────────────────────────────────────────────────────
# Sara — environment template
#
# Copy to `.env` (repo root) and fill in real values. NEVER commit `.env`.
# Only placeholder values live in this file (checked by `npm run verify`).
# Variables marked (Phase N+) are consumed by later phases and are listed
# here so the full contract is visible from day one.
# ──────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# Pretty-print logs in the terminal (true/false). Defaults to true in development.
LOG_PRETTY=
# Port and bind host for the API service (Phase 1+)
API_PORT=4000
HOST=0.0.0.0
# Public base URL of the web dashboard (used for docs/CORS references)
APP_URL=http://localhost:3000
# Browsers talk to the API same-origin; the web app proxies /api/* to this URL.
# Comma-separated list of additional browser origins allowed by CORS (optional).
CORS_ORIGINS=http://localhost:3000
# URL the web server uses internally to reach the API (server-side)
API_INTERNAL_URL=http://127.0.0.1:4000

# ── Database (Phase 1 foundation; full usage Phase 2+) ───────────
# SQLite via Node's built-in driver (see ADR 0003). Relative file: paths
# resolve against packages/db/. Apply migrations with: npm run db:migrate
DATABASE_URL=file:./data/sara.db
# PostgreSQL (production, Phase 2+ decision), e.g. postgres://user:password@localhost:5432/sara
# DATABASE_URL=

# ── Security / Auth ──────────────────────────────────────────────
# Long random string used to sign sessions. Generate with: openssl rand -hex 32
# If unset in Phase 1, an ephemeral per-process secret is used (sessions reset on restart).
SESSION_SECRET=changeme-generate-a-real-random-secret
# Single-operator bootstrap credentials (Phase 1 foundation; replaced by DB
# users + full auth in Phase 2). Login is DISABLED while the password is unset.
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=

# ── AI / LLM provider (Phase 3+) ─────────────────────────────────
# Which provider the orchestrator uses: openai | anthropic | openai-compatible | ollama
LLM_PROVIDER=
# Provider credentials — fill only the one selected above
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional custom endpoint for OpenAI-compatible / local servers (e.g. Ollama)
LLM_BASE_URL=
# Default model identifier, e.g. gpt-4o-mini / claude-sonnet-4-5 / llama3
LLM_MODEL=

# ── Voice (Phase 7+) ─────────────────────────────────────────────
STT_PROVIDER=
TTS_PROVIDER=
ELEVENLABS_API_KEY=

# ── Social platforms (Phase 11+, official APIs only) ─────────────
# Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=
# Instagram (via Meta Graph API)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# YouTube (Google Data API v3)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_API_KEY=
# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── Clip Finder (AI Drama Clip Finder) ───────────────────────────
# Force mock AI providers (labeled DEMO/MOCK in the UI). When unset, mocks
# are used automatically unless OPENAI_API_KEY below is configured.
MOCK_CLIP_FINDER=
# Background worker concurrency (1-4)
CLIP_FINDER_CONCURRENCY=1
# Upload / URL download size limits (MB) and max source duration (minutes)
CLIP_FINDER_MAX_UPLOAD_MB=512
CLIP_FINDER_MAX_URL_SIZE_MB=1024
CLIP_FINDER_MAX_DURATION_MIN=120
# ffmpeg scene-change sensitivity (0.05-0.95; lower = more scene cuts; default 0.3)
CLIP_FINDER_SCENE_THRESHOLD=
# Automatic cleanup of temp artifacts and old renders (hours)
CLIP_FINDER_RETENTION_HOURS=24
# Storage root for uploads, temp artifacts and renders (default: <repo>/data/clip-finder)
# CLIP_FINDER_DATA_DIR=
# Explicit ffmpeg/ffprobe paths (default: npm-bundled @ffmpeg-installer binaries)
# CLIP_FINDER_FFMPEG_PATH=
# CLIP_FINDER_FFPROBE_PATH=
# Optional OpenAI-compatible endpoint override (leave unset for the official API)
# OPENAI_BASE_URL=
# Transcription model (default whisper-1; supports Urdu/Hindi/English among others)
WHISPER_MODEL=

# ── Sara AI — virtual LIVE host ──────────────────────────────────
# LLM: auto picks openai→anthropic→ollama→offline from available keys.
# offline = built-in scripted persona (labeled in the dashboard; no key needed).
SARA_LLM_PROVIDER=auto
# SARA_LLM_MODEL=            # default: gpt-4o-mini / claude-sonnet-4-6 / llama3.1
# SARA_LLM_BASE_URL=         # OpenAI-compatible endpoint (Ollama: http://localhost:11434/v1)
# Voice chain: avatar-engine (GPU Chatterbox) → openai → edge-tts → piper → bundled offline.
# SARA_TTS_ENGINE_URL=       # AvatarAI engine base URL (services/avatar-engine, GPU)
# SARA_VOICE_ID=             # cloned voice id inside the engine (authorized voices only)
# SARA_TTS_EDGE_PYTHON=      # python binary with edge-tts installed
# SARA_TTS_PIPER_VOICE=      # path to a piper .onnx voice file
# SARA_AVATAR_ENGINE_URL=    # enables real-time MuseTalk lip-sync (NVIDIA GPU required)
# SARA_AVATAR_ID=
# TikTok: ONLY an officially authorized events endpoint (webhook/relay). Sara refuses
# unofficial scraping/cookie access; without this Sara runs in simulator mode.
# SARA_TIKTOK_EVENTS_URL=
# SARA_TIKTOK_TOKEN=         # bearer secret for your own webhook relay
SARA_SIMULATOR=true
SARA_MEMORY_ENABLED=true
SARA_RESPONSES_PER_MINUTE=8
# SARA_AI_DISCLOSURE=🤖 Sara is an AI virtual character.

# ── Background workers / queue (Phase 6+) ────────────────────────
REDIS_URL=
