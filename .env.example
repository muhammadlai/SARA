# ──────────────────────────────────────────────────────────────────
# Sara — environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Only placeholder values live in this file (checked by `npm run verify`).
# Variables marked (Phase N+) are consumed by later phases and are
# listed here so the full contract is visible from day one.
# ──────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# Public base URL of the web dashboard
APP_BASE_URL=http://localhost:3000
# Port for the API service (Phase 1+)
API_PORT=4000

# ── Database (Phase 2+) ──────────────────────────────────────────
# Postgres connection string, e.g. postgres://user:password@localhost:5432/sara
DATABASE_URL=

# ── Security / Auth (Phase 2+) ───────────────────────────────────
# Long random string used to sign sessions. Generate e.g. with:
#   openssl rand -hex 32
SESSION_SECRET=changeme

# ── AI / LLM provider (Phase 3+) ─────────────────────────────────
# Which provider the orchestrator uses: openai | anthropic | openai-compatible | ollama
LLM_PROVIDER=
# Provider credentials — fill only the one selected above
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional custom endpoint for OpenAI-compatible / local servers (e.g. Ollama)
LLM_BASE_URL=
# Default model identifier, e.g. gpt-4o-mini / claude-sonnet-4-5 / llama3
LLM_MODEL=

# ── Voice (Phase 7+) ─────────────────────────────────────────────
STT_PROVIDER=
TTS_PROVIDER=
ELEVENLABS_API_KEY=

# ── Social platforms (Phase 11+, official APIs only) ─────────────
# Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=
# Instagram (via Meta Graph API)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# YouTube (Google Data API v3)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_API_KEY=
# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── Background workers / queue (Phase 6+) ────────────────────────
REDIS_URL=
