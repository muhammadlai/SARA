# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Environment & secrets (never commit these) ───────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Builds & output ──────────────────────────────────────────
dist/
build/
out/
.next/
*.tsbuildinfo

# ── Test & coverage ──────────────────────────────────────────
coverage/
.nyc_output/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── Runtime data (uploads, local DB files, caches) ───────────
data/
uploads/
media/cache/

# ── Editor / OS ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# ── Tooling caches ───────────────────────────────────────────
.turbo/
.eslintcache
